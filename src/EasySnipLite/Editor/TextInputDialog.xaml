<Window x:Class="EasySnipLite.Editor.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入文字" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FF2D2D30"
        WindowStyle="ToolWindow">
    <StackPanel Margin="14,12">
        <TextBox x:Name="Input" FontSize="16" Height="30" Padding="6,4" VerticalContentAlignment="Center" MaxLength="200"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="72" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="72" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
