<Window x:Class="EasySnipLite.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasySnipLite.Editor"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30" Width="960" Height="640" MinWidth="640" MinHeight="420"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 画布区 -->
        <Border Grid.Row="0" Background="#FF1E1E22" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <local:AnnotationCanvas x:Name="Canvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp"/>
            </ScrollViewer>
        </Border>

        <!-- 工具条 / 动作条 -->
        <Border Grid.Row="1" Background="#FF2D2D30" Padding="6,5">
            <WrapPanel>
                <ToggleButton x:Name="BtnSelection" Tag="Selection" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnRect" Tag="Rectangle" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnEllipse" Tag="Ellipse" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnArrow" Tag="Arrow" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnFreehand" Tag="Freehand" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnHighlighter" Tag="Highlighter" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnMosaic" Tag="Mosaic" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnText" Tag="Text" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnEmoji" Tag="Emoji" Checked="ToolButton_Checked" Margin="0,0,8,0"/>

                <Separator Width="1" Height="22" Background="#FF55555A" Margin="0,2,8,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <Button x:Name="ColorRed" Width="18" Height="18" Background="#FFE53935" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                    <Button x:Name="ColorOrange" Width="18" Height="18" Background="#FFFF9800" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                    <Button x:Name="ColorYellow" Width="18" Height="18" Background="#FFFFEB3B" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                    <Button x:Name="ColorGreen" Width="18" Height="18" Background="#FF4CAF50" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                    <Button x:Name="ColorBlue" Width="18" Height="18" Background="#FF2196F3" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                    <Button x:Name="ColorPurple" Width="18" Height="18" Background="#FF9C27B0" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                    <Button x:Name="ColorBlack" Width="18" Height="18" Background="#FF000000" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                    <Button x:Name="ColorWhite" Width="18" Height="18" Background="#FFFFFFFF" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0"/>
                </StackPanel>

                <ComboBox x:Name="StrokeWidthCombo" Width="52" Margin="4,0,8,0" VerticalContentAlignment="Center" SelectionChanged="StrokeWidth_Changed"/>

                <Button x:Name="BtnUndo" Click="Undo_Click" Margin="0,0,3,0" ToolTip="Ctrl+Z"/>
                <Button x:Name="BtnRedo" Click="Redo_Click" Margin="0,0,3,0" ToolTip="Ctrl+Y"/>
                <Button x:Name="BtnDelete" Click="Delete_Click" Margin="0,0,8,0" ToolTip="Delete"/>

                <Separator Width="1" Height="22" Background="#FF55555A" Margin="0,2,8,0"/>

                <Button x:Name="BtnCopy" Click="Copy_Click" Margin="0,0,3,0" ToolTip="Ctrl+C"/>
                <Button x:Name="BtnSave" Click="Save_Click" Margin="0,0,3,0" ToolTip="Ctrl+S"/>
                <Button x:Name="BtnPin" Click="Pin_Click" Margin="0,0,3,0"/>
                <Button x:Name="BtnComplete" Click="Complete_Click" Margin="0,0,3,0" FontWeight="Bold"/>
            </WrapPanel>
        </Border>

        <!-- 表情选择面板 -->
        <Popup x:Name="EmojiPopup" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="4" Padding="8" MaxWidth="400">
                <TabControl>
                    <TabItem x:Name="TabSmile">
                        <ItemsControl ItemsSource="{Binding Smile}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabGesture">
                        <ItemsControl ItemsSource="{Binding Gesture}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabAnimal">
                        <ItemsControl ItemsSource="{Binding Animal}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabFood">
                        <ItemsControl ItemsSource="{Binding Food}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabObject">
                        <ItemsControl ItemsSource="{Binding Object}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                </TabControl>
            </Border>
        </Popup>
    </Grid>
</Window>
