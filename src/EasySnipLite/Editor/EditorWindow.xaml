<Window x:Class="EasySnipLite.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasySnipLite.Editor"
        Title="标注编辑器" WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30" Width="960" Height="640" MinWidth="640" MinHeight="420"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 画布区 -->
        <Border Grid.Row="0" Background="#FF1E1E22" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <local:AnnotationCanvas x:Name="Canvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp"/>
            </ScrollViewer>
        </Border>

        <!-- 工具条 / 动作条 -->
        <Border Grid.Row="1" Background="#FF2D2D30" Padding="6,5">
            <WrapPanel>
                <ToggleButton x:Name="BtnSelection" Content="选择" Tag="Selection" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnRect" Content="矩形" Tag="Rectangle" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnEllipse" Content="椭圆" Tag="Ellipse" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnArrow" Content="箭头" Tag="Arrow" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnFreehand" Content="画笔" Tag="Freehand" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnHighlighter" Content="荧光" Tag="Highlighter" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnMosaic" Content="马赛克" Tag="Mosaic" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnText" Content="文字" Tag="Text" Checked="ToolButton_Checked" Margin="0,0,3,0"/>
                <ToggleButton x:Name="BtnEmoji" Content="表情" Tag="Emoji" Checked="ToolButton_Checked" Margin="0,0,8,0"/>

                <Separator Width="1" Height="22" Background="#FF55555A" Margin="0,2,8,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <Button x:Name="ColorRed" Width="18" Height="18" Background="#FFE53935" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="红色"/>
                    <Button x:Name="ColorOrange" Width="18" Height="18" Background="#FFFF9800" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="橙色"/>
                    <Button x:Name="ColorYellow" Width="18" Height="18" Background="#FFFFEB3B" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="黄色"/>
                    <Button x:Name="ColorGreen" Width="18" Height="18" Background="#FF4CAF50" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="绿色"/>
                    <Button x:Name="ColorBlue" Width="18" Height="18" Background="#FF2196F3" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="蓝色"/>
                    <Button x:Name="ColorPurple" Width="18" Height="18" Background="#FF9C27B0" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="紫色"/>
                    <Button x:Name="ColorBlack" Width="18" Height="18" Background="#FF000000" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="黑色"/>
                    <Button x:Name="ColorWhite" Width="18" Height="18" Background="#FFFFFFFF" BorderThickness="0" Click="ColorButton_Click" Margin="0,2,3,0" ToolTip="白色"/>
                </StackPanel>

                <ComboBox x:Name="StrokeWidthCombo" Width="52" Margin="4,0,8,0" VerticalContentAlignment="Center" SelectionChanged="StrokeWidth_Changed" ToolTip="线宽"/>

                <Button Content="撤销" Click="Undo_Click" Margin="0,0,3,0" ToolTip="Ctrl+Z"/>
                <Button Content="重做" Click="Redo_Click" Margin="0,0,3,0" ToolTip="Ctrl+Y"/>
                <Button Content="删除" Click="Delete_Click" Margin="0,0,8,0" ToolTip="Delete"/>

                <Separator Width="1" Height="22" Background="#FF55555A" Margin="0,2,8,0"/>

                <Button Content="复制" Click="Copy_Click" Margin="0,0,3,0" ToolTip="Ctrl+C"/>
                <Button Content="保存" Click="Save_Click" Margin="0,0,3,0" ToolTip="Ctrl+S"/>
                <Button Content="贴到屏幕" Click="Pin_Click" Margin="0,0,3,0" ToolTip="贴到屏幕"/>
                <Button Content="完成" Click="Complete_Click" Margin="0,0,3,0" FontWeight="Bold" ToolTip="复制并关闭 (Enter)"/>
            </WrapPanel>
        </Border>

        <!-- 表情选择面板 -->
        <Popup x:Name="EmojiPopup" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="4" Padding="8" MaxWidth="400">
                <TabControl>
                    <TabItem Header="笑脸">
                        <ItemsControl ItemsSource="{Binding Smile}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="手势">
                        <ItemsControl ItemsSource="{Binding Gesture}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="动物">
                        <ItemsControl ItemsSource="{Binding Animal}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="食物">
                        <ItemsControl ItemsSource="{Binding Food}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="物品">
                        <ItemsControl ItemsSource="{Binding Object}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                </TabControl>
            </Border>
        </Popup>
    </Grid>
</Window>
