<Window x:Class="EasySnipLite.Selection.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:EasySnipLite.Editor"
        Title="EasySnipLite"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- 调整手柄样式:蓝色方块白边 -->
        <Style x:Key="HandleStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#FF2D9CFF" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </Window.Resources>
    <Canvas x:Name="RootCanvas">
        <!-- 冻结的画面（物理像素 1:1 显示） -->
        <Image x:Name="FrozenImage" Stretch="None" />
        <!-- 选区外的暗化遮罩（四块） -->
        <Rectangle x:Name="MaskTop" Fill="#80000000" />
        <Rectangle x:Name="MaskBottom" Fill="#80000000" />
        <Rectangle x:Name="MaskLeft" Fill="#80000000" />
        <Rectangle x:Name="MaskRight" Fill="#80000000" />
        <!-- 内联标注层（issue #20）：冻结选区图像 + 矢量标注，LayoutTransform 按显示器 DpiScale 缩放到 1:1 物理像素 -->
        <editor:AnnotationCanvas x:Name="AnnotationLayer"
                                 ClipToBounds="True"
                                 Visibility="Collapsed" />
        <!-- 选区边框 -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FF2D9CFF"
                   StrokeThickness="1"
                   StrokeDashArray="2 2"
                   Fill="#12FFFFFF"
                   Visibility="Collapsed" />
        <!-- 8 个调整手柄(调整态可见) -->
        <Rectangle x:Name="HandleNW" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <Rectangle x:Name="HandleNE" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <Rectangle x:Name="HandleSW" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <Rectangle x:Name="HandleSE" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <Rectangle x:Name="HandleTop" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <Rectangle x:Name="HandleBottom" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <Rectangle x:Name="HandleLeft" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <Rectangle x:Name="HandleRight" Style="{StaticResource HandleStyle}" Visibility="Collapsed" />
        <!-- 尺寸标签 -->
        <Border x:Name="SizeLabel"
                Visibility="Collapsed"
                Background="#CC000000"
                CornerRadius="3"
                Padding="5,2">
            <TextBlock x:Name="SizeText"
                       Foreground="White"
                       FontSize="12"
                       FontFamily="Segoe UI" />
        </Border>
        <!-- 角点放大镜(拖动中显示:9x9 像素最近邻放大 + 坐标 + 颜色) -->
        <Border x:Name="Magnifier"
                Visibility="Collapsed"
                Background="#F0FFFFFF"
                BorderBrush="#FF2D9CFF"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
            <StackPanel>
                <Image x:Name="MagImage"
                       Width="54" Height="54"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="MagInfo"
                           Foreground="Black"
                           FontSize="11"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 表情选择面板（标注模式文字/表情工具点击后显示） -->
        <Popup x:Name="EmojiPopup" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#FFB0B0B0" BorderThickness="1" CornerRadius="4" Padding="8" MaxWidth="400">
                <TabControl>
                    <TabItem x:Name="TabSmile">
                        <ItemsControl ItemsSource="{Binding Smile}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabGesture">
                        <ItemsControl ItemsSource="{Binding Gesture}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabAnimal">
                        <ItemsControl ItemsSource="{Binding Animal}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabFood">
                        <ItemsControl ItemsSource="{Binding Food}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem x:Name="TabObject">
                        <ItemsControl ItemsSource="{Binding Object}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Segoe UI Emoji" FontSize="20" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                </TabControl>
            </Border>
        </Popup>
    </Canvas>
</Window>
