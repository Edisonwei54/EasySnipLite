<Window x:Class="EasySnipLite.Stitching.StitchPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="滚动长截图" WindowStartupLocation="Manual" ShowActivated="False"
        Background="#FF2D2D30" Width="420" Height="320" MinWidth="320" MinHeight="220"
        Loaded="OnLoaded" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 状态栏 -->
        <Border Grid.Row="0" Background="#FF1E1E22" Padding="8,6" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Foreground="White" Text="正在捕获…" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 1:1 实时预览 + 接缝标红 -->
        <Border Grid.Row="1" Background="#FF1E1E22" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Canvas x:Name="SeamOverlay" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 动作条 -->
        <Border Grid.Row="2" Background="#FF2D2D30" Padding="6,5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStop" Content="停止" Click="Stop_Click" Margin="0,0,3,0"/>
                <Button x:Name="BtnRetry" Content="重试" Visibility="Collapsed" Click="Retry_Click" Margin="0,0,8,0" ToolTip="从失败接缝处继续捕获"/>
                <Separator Width="1" Height="22" Background="#FF55555A" Margin="0,2,8,0"/>
                <Button x:Name="BtnCopy" Content="复制" Visibility="Collapsed" Click="Copy_Click" Margin="0,0,3,0"/>
                <Button x:Name="BtnSave" Content="保存" Visibility="Collapsed" Click="Save_Click" Margin="0,0,3,0"/>
                <Button x:Name="BtnComplete" Content="完成" Visibility="Collapsed" FontWeight="Bold" Click="Complete_Click" Margin="0,0,3,0" ToolTip="复制并关闭"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
